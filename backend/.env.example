DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sri_apartment_os

# OS10-TEST-ISOLATION-01: required to run pytest at all — see
# tests/conftest.py. Must point at a database whose name contains "test"
# and must differ from DATABASE_URL above, or the suite refuses to start.
# When running via docker-compose, this maps to the separate `test-db`
# service (port 5433 on the host); this localhost value is for running
# pytest directly against Docker's exposed test-db port from outside a container.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/sri_apartment_os_test

JWT_SECRET_KEY=CHANGE_ME_generate_a_random_64_char_string_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development

# RBAC Phase A: required the FIRST time seed runs against a database with
# no admin user yet — creates the initial admin account with this
# password. Never hardcoded in source; not read again after that first
# run. Set a real, unique value before first deploy; safe to rotate the
# admin's actual password afterward and leave this unset/stale.
BOOTSTRAP_ADMIN_PASSWORD=

# CORS — comma-separated list of frontend origins allowed to call this API
# from a browser. Defaults cover local dev only. A production deployment
# MUST change this to its real frontend domain(s), e.g.:
#   CORS_ALLOWED_ORIGINS=https://app.sriapartmenthomestay.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email (SMTP) — leave blank to keep email-sending endpoints honestly
# returning "501 not configured" instead of pretending to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=homestaypdy@gmail.com
SMTP_USE_TLS=true

# WhatsApp click-to-chat default country code (used for 10-digit phone numbers)
DEFAULT_COUNTRY_CODE=91

# Base URL of the public customer-facing website. Used for password-reset
# email links AND (Phase 3G) every redirect back to the frontend after a
# Google OAuth attempt. Local dev default shown; production sets this to
# the real frontend domain, e.g.:
#   CUSTOMER_PORTAL_BASE_URL=https://sriapartment.in
CUSTOMER_PORTAL_BASE_URL=http://localhost:5175

# Google OAuth (customer-facing "Continue with Google") — leave blank to
# keep the honest "not configured" behavior (button shown, backend
# returns 501, frontend shows a professional message) instead of a fake
# login. From Google Cloud Console > APIs & Services > Credentials >
# OAuth client ID (Web application). GOOGLE_REDIRECT_URI must be
# registered EXACTLY in that same console entry's Authorized redirect
# URIs. Local dev default shown; production sets these to the real API
# domain, e.g.:
#   GOOGLE_REDIRECT_URI=https://api.sriapartment.in/api/v1/customer-auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/customer-auth/oauth/google/callback

# Background reminder scheduler — off by default. Set true to enable
# automatic email reminders (check-in/check-out/review/payment).
ENABLE_SCHEDULER=false
REMINDER_SCAN_INTERVAL_MINUTES=60

# Razorpay — leave blank to keep order-creation/refund endpoints honestly
# returning "501 not configured". Webhook signature verification works
# with any RAZORPAY_WEBHOOK_SECRET (real or test) independent of the other two.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Zotel channel-manager (OTA availability/reservation sync) — leave blank
# to keep Zotel integration endpoints inactive. ZOTEL_BASE_URL and
# ZOTEL_HOTEL_ID come from your Zotel account manager — the base URL is
# per-property, not a shared Zotel domain, and both are required on every
# request alongside the key/secret headers.
ZOTEL_BASE_URL=
ZOTEL_API_KEY=
ZOTEL_API_SECRET=
ZOTEL_HOTEL_ID=
