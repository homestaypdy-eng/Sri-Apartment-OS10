# Copy this file to .env and fill in real values before running
# `docker compose up` in any environment reachable by real users.
# .env is gitignored — never commit your actual filled-in copy.

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_A_REAL_RANDOM_PASSWORD
POSTGRES_DB=sri_apartment_os

# --- Test database (OS10-TEST-ISOLATION-01) ---
# A completely separate Postgres service (test-db in docker-compose.yml),
# never the dev database above. pytest refuses to run at all unless
# TEST_DATABASE_URL is set and points here — see backend/tests/conftest.py.
# Reuses POSTGRES_USER/PASSWORD; only the database name differs.
POSTGRES_TEST_DB=sri_apartment_os_test

# --- Backend ---
# Generate a real one with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_REAL_RANDOM_SECRET
# Comma-separated list of the exact frontend URL(s) allowed to call this API.
# Do not include "localhost" once this is deployed somewhere real users reach.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Initial admin bootstrap (RBAC Phase A) ---
# Required the first time seed runs against a database with no admin user
# yet; creates that one initial admin account with this password, then is
# never read again. Set a real, unique value before first deploy. No
# default is hardcoded anywhere in source — an unset value here makes
# admin bootstrap fail loudly instead of using a guessable password.
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_TO_A_REAL_RANDOM_PASSWORD

# --- Email (optional) ---
# Leave blank to keep email-send features honestly returning "not configured"
# instead of silently failing. Fill in only if you want automatic emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=homestaypdy@gmail.com

# --- Email provider switch ---
# "gmail_smtp" (default) uses the SMTP_* config above, unchanged.
# "resend" uses the Resend HTTP API config below instead — sender is
# ALWAYS RESEND_FROM_EMAIL, never SMTP_FROM_EMAIL. Leave EMAIL_PROVIDER
# unset/"gmail_smtp" unless you're deliberately testing the Resend path.
EMAIL_PROVIDER=gmail_smtp
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- LOCAL customer login Email OTP testing (never consulted in
# production — see backend/app/modules/customer_auth/router.py) ---
# "dev_code" (default): no email is ever sent; the API response carries
# dev_otp_code instead, and the frontend shows a "development mode" notice.
# "real_email": sends a REAL email through the SMTP config above, but
# ONLY to addresses listed in CUSTOMER_AUTH_EMAIL_OTP_TEST_ALLOWLIST below —
# leaving the allowlist empty means "real_email" mode still sends to no one.
CUSTOMER_AUTH_EMAIL_OTP_MODE=dev_code
# Comma-separated exact-match email addresses allowed to receive a real
# login OTP email in "real_email" mode, e.g. your own test Gmail address.
CUSTOMER_AUTH_EMAIL_OTP_TEST_ALLOWLIST=

# --- Razorpay (optional) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Zotel channel-manager (optional) ---
# Leave blank to keep Zotel integration endpoints inactive. Base URL and
# hotel_id come from your Zotel account manager (per-property, not a
# shared Zotel domain).
ZOTEL_BASE_URL=
ZOTEL_API_KEY=
ZOTEL_API_SECRET=
ZOTEL_HOTEL_ID=

# --- Background reminder scheduler ---
ENABLE_SCHEDULER=false
REMINDER_SCAN_INTERVAL_MINUTES=60
ZOTEL_SYNC_INTERVAL_MINUTES=15

# --- Frontend build-time variable ---
# The URL the frontend's browser JS calls — must be reachable from wherever
# your guests'/staff's browsers actually are, not just from inside Docker.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Local Guest ID storage is private and persists in the Compose named volume.
# Production should select the private S3-compatible adapter. Before enabling
# it, provision a private bucket, block public access, enable object versioning
# or equivalent backups, and verify a restore procedure. No URLs are returned.
GUEST_DOCUMENT_STORAGE_BACKEND=local
GUEST_DOCUMENT_STORAGE_DIR=/tmp/sri_apartment_guest_documents
GUEST_DOCUMENT_S3_BUCKET=
GUEST_DOCUMENT_S3_REGION=
GUEST_DOCUMENT_S3_ENDPOINT_URL=
GUEST_DOCUMENT_S3_ADDRESSING_STYLE=auto
GUEST_DOCUMENT_S3_ACCESS_KEY_ID=
GUEST_DOCUMENT_S3_SECRET_ACCESS_KEY=
GUEST_DOCUMENT_S3_SERVER_SIDE_ENCRYPTION=AES256
